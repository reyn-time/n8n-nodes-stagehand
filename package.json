{
	"name": "@dndr/n8n-nodes-stagehand",
	"version": "1.8.0",
	"description": "Stagehand.dev custom nodes for n8n",
	"keywords": [
		"n8n-community-node-package"
	],
	"license": "MIT",
	"author": {
		"name": "HighLiuk"
	},
	"homepage": "https://github.com/reyn-time/n8n-nodes-stagehand",
	"repository": {
		"type": "git",
		"url": "https://github.com/reyn-time/n8n-nodes-stagehand.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"main": "index.js",
	"scripts": {
		"build": "rimraf dist && tsc && node scripts/copy-icons.cjs",
		"dev": "tsc --watch",
		"test": "vitest run",
		"format": "prettier nodes tests package.json --write",
		"format:check": "prettier --check nodes tests package.json",
		"lint": "eslint nodes package.json",
		"lintfix": "eslint nodes package.json --fix",
		"typecheck": "tsc --noEmit",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm test",
		"prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes package.json"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [],
		"nodes": [
			"dist/nodes/CdpTools/CdpTools.node.js",
			"dist/nodes/Playwright/Playwright.node.js",
			"dist/nodes/Stagehand/Stagehand.node.js"
		]
	},
	"devDependencies": {
		"@langchain/core": "^1.4.1",
		"@typescript-eslint/parser": "^8.73.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"n8n-workflow": "^2.16.0",
		"prettier": "^3.5.3",
		"rimraf": "^6.1.4",
		"typescript": "^5.8.2",
		"vite": "^6.4.6",
		"vitest": "^4.1.12"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"@browserbasehq/stagehand": "4.4.0",
		"json-schema-to-zod": "^2.6.1",
		"json-to-zod": "^1.1.2",
		"playwright": "^1.65.1",
		"zod-v4": "npm:zod@4.6.6"
	}
}
